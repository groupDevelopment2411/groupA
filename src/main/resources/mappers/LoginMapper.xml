<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.login.LoginMapper">

  <select id="findByIdAndPassword" parameterType="map" resultType="com.example.demo.login.LoginEmployee">
    SELECT * FROM employee WHERE id = #{id} AND password = #{password}
  </select>

</mapper>
